generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// 這是你的 Threads 貼文資料表
model ThreadPost {
  id        String   @id @default(cuid())
  url       String
  title     String
  content   String?
  summary   String?
  category  String?
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([folderId])
}

model Folder {
  id        String       @id @default(cuid())
  name      String       @unique
  posts     ThreadPost[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
